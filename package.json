{
  "name": "quantum-app",
  "version": "1.0.0",
  "description": "KVANTOVÁ RULETA PRO V2",
  "productName": "RULETA",
  "author": "Quantum",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/sync-v2.cjs && electron .",
    "sync-v2": "node scripts/sync-v2.cjs",
    "test:v2": "electron scripts/tests/_test_v4_comprehensive.cjs",
    "test:v2:audit": "electron scripts/tests/_test_v4_audit.cjs",
    "test:v2:wheel": "electron scripts/tests/_test_v4_wheel_deep.cjs",
    "test:v2:deep": "electron scripts/tests/_test_v4_deep.cjs",
    "test:v2:layout": "electron scripts/tests/_test_v4.cjs",
    "test:v2:sk": "electron scripts/tests/_test_v4_sk_full.cjs",
    "test:v2:master": "electron scripts/tests/_test_v4_master.cjs",
    "test:v2:all": "node scripts/sync-v2.cjs && electron scripts/tests/_test_v4_sk_full.cjs",
    "test:v2:ci": "npm run test:v2:master && npm run test:v2 && npm run test:v2:audit && npm run test:v2:wheel && npm run test:v2:deep && npm run test:v2:layout",
    "pre-dist": "node scripts/pre-dist.cjs",
    "dist:unlock": "node scripts/pre-dist.cjs",
    "dist": "node scripts/sync-v2.cjs && node scripts/pre-dist.cjs && node scripts/dist-run.cjs",
    "upratat": "node scripts/upratat-vsetko.cjs",
    "avast": "powershell -ExecutionPolicy Bypass -File scripts/setup-avast-vyluckenie.ps1",
    "desktop": "powershell -ExecutionPolicy Bypass -File scripts/nainstaluj-odkaz-na-plochu.ps1"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.quantum.ruleta",
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "styles/**/*.css",
      "scripts/**/*.js",
      "!scripts/tests/**",
      "!scripts/_extract*.cjs",
      "!scripts/**/_test*.cjs"
    ],
    "directories": {
      "output": ".build-out"
    },
    "win": {
      "target": "dir",
      "executableName": "RULETA",
      "signAndEditExecutable": false
    }
  }
}
